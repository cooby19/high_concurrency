{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "cpuRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed"
      ],
      "properties": {
        "seed": {
          "$ref": "#/$defs/uint32"
        }
      }
    },
    "jsonRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "values",
        "padding"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uint32"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,32}$",
          "not": {
            "pattern": "[^A-Za-z0-9_]"
          }
        },
        "values": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000
          }
        },
        "padding": {
          "const": ""
        }
      }
    }
  }
}
